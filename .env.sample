# ==============================================
# .env.sample — github-log 用テンプレート
#
# 使い方:
#   cp .env.sample .env
#   その後、各値を埋める（< > の中はダミー文字列）
# ==============================================

# ---- 必須 ----

# GitHub Personal Access Token
# 必要スコープ: repo (PR / Issue 検索), read:org (Organization フィルタ)
GITHUB_TOKEN=<your-github-token>

# 分析対象の GitHub ユーザー名（自分）
GITHUB_USER_NAME=<your-github-username>

# 分析対象とする GitHub Organization 名
# このOrgに属さないリポジトリのPRは集計から除外される（個人プロジェクトの混入を防ぐ）
# 例: pocake
GITHUB_ORG=<your-organization>

# Slack Bot Token (chat:write 権限が必要)
SLACK_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# Slack 投稿先チャンネル ID (例: C0123456789)
SLACK_CHANNEL=<your-channel-id>


# ---- 任意 ----

# Notion 作業ログ DB の URL
# 未設定なら Notion 投稿はスキップされ、Slack 投稿とローカル JSON/Markdown 保存だけ動く
# 例: https://www.notion.so/<workspace>/2f3880bd573580f08a49ed92c6b7ccfd
NOTION_DATABASE_URL=

# 個人/チームの目標 Markdown が保管されているリポジトリ (owner/repo 形式)
# 例: uto-usui/obsidian
GOALS_REPO=

# 目標 Markdown ファイルのパス（カンマ区切り）
# 半角スペース・日本語を含む場合はダブルクオートで囲む
# 例:
#   GOALS_PATHS="database/memos/goal-setting/2026H2 個人目標.md,database/memos/goal-setting/2026H2チーム目標.md"
GOALS_PATHS=
